# --- Letter C1 (06/08/2026): habilitar stack MTK de rendimiento ---
# Gate maestro del directorio drivers/misc/mediatek/performance/
# (touch_boost, fpsgo_v3, load_track, perf_ioctl, frs)
# Lineage lo deshabilitó en lineage.config (# CONFIG_MTK_PERFORMANCE_MODULE is not set)
# Por eso no existen /proc/touch_boost ni /proc/fpsgo en el dispositivo.
CONFIG_MTK_PERFORMANCE_MODULE=y
CONFIG_MTK_FPSGO_V3=y
