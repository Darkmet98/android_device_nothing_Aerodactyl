# --- Letter A (05/08/2026): tuning GKI seguro ---
# BBR como congestion control por defecto (red más fluida, latencia mejorada)
# PITFALL: DEFAULT_TCP_CONG es símbolo derivado de una choice; hay que activar
# la choice (DEFAULT_BBR), no la cadena (olddefconfig la revierte a cubic).
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
